{
  "manifest_version": 3,
  "name": "Yaoki Reader",
  "version": "1.0.0",
  "description": "Touch a Japanese word on any page and hold it to see its reading over the kanji and each word's meaning; let go and it hides.",
  "homepage_url": "https://jorycook.github.io/Yaoki-reader/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Yaoki Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Switch Yaoki Reader on or off"
    }
  },
  "permissions": ["storage", "offscreen"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
